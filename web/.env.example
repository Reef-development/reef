# Copy to web/.env (which git ignores).
# Sign-in still goes through Supabase Auth, so the web app needs the project URL and publishable key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
# Where the REEF API is running.
VITE_API_URL=http://localhost:8787
