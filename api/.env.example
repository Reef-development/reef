# Copy to api/.env (which git ignores) and fill in.
PORT=8787
# The Supabase project. Only the publishable key is needed: the API verifies sign-ins against
# the project's public signing keys and forwards each caller's own token, so row-level security
# still applies underneath the API's own permission checks.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8080
# Emailing service reminders (T17). Optional: without SMTP_URL reminders still show in the app.
# One URL names the server and login, e.g. smtps://user:password@smtp.example.com:465
# SMTP_URL=
MAIL_FROM=REEF Operations <no-reply@reef.co.za>
# The web app's address, for the link in each email. Defaults to the first CORS origin.
# APP_URL=
