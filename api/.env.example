# Copy to api/.env (which git ignores) and fill in.
PORT=8787
# The Supabase project. Only the publishable key is needed: the API verifies sign-ins against
# the project's public signing keys and forwards each caller's own token, so row-level security
# still applies underneath the API's own permission checks.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8080
# How long employee information is kept, in years, as REEF instructed. Five years for an
# identity number after the person leaves; seven for the rest of the record, which is the
# shortest period inside the seven to ten REEF gave. docs/privacy.md is the written rule.
RETENTION_IDENTITY_YEARS=5
RETENTION_RECORD_YEARS=7
# The service reminder sweep. It runs with no user behind it, so it cannot borrow a caller's
# token and needs its own credential. Leave it out and the API still serves every request: the
# sweep simply does not run, says so at start-up, and every day shows as missed on
# GET /api/v1/admin/jobs. This key bypasses row-level security, so it stays on the server, never
# reaches the web app, and is never committed.
SUPABASE_SERVICE_ROLE_KEY=
# REEF's own calendar day, so a run started at 00:30 is filed against the right day.
SCHEDULE_TIMEZONE=Africa/Johannesburg
